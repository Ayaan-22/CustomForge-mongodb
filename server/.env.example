NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/customforge?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-different-long-random-secret
JWT_SHORT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_COOKIE_EXPIRES_IN=30
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
TRUST_PROXY=false
# Set REDIS_URL before running multiple API processes.
REDIS_URL=
# Development only: preview saves email HTML locally instead of sending.
EMAIL_MODE=preview
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=CustomForge <hello@example.com>
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
